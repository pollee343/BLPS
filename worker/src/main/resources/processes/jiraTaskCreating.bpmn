  <bpmn:collaboration id="Collaboration_06bdfy9">
    <bpmn:participant id="Participant_03hcnd9" name="Выгрузка заявки в Jira" processRef="Process_0rqve3c" />
  </bpmn:collaboration>
  <bpmn:process id="Process_0rqve3c" name="Выгрузка заявки в Jira" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:laneSet id="LaneSet_0icmf1z">
      <bpmn:lane id="Lane_0hon19q" name="База данных" />
      <bpmn:lane id="Lane_1nqq8mv" name="worker">
        <bpmn:flowNodeRef>Event_StartJiraExport</bpmn:flowNodeRef>
