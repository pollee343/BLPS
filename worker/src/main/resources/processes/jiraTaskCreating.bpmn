      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_StartJiraExport" name="Получено сообщение о новой заявке">
      <bpmn:outgoing>Flow_1v13nej</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1mkcuq5" messageRef="Message_PromisedPaymentRejectionCreated" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_1er5nd7" name="Получение заявки по id" camunda:delegateExpression="${loadApplicationForJiraDelegate}">
      <bpmn:incoming>Flow_1v13nej</bpmn:incoming>
      <bpmn:outgoing>Flow_1umzobz</bpmn:outgoing>
      <bpmn:property id="Property_1pyo2le" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1moj3zf">
        <bpmn:sourceRef>DataStoreReference_0zhy1qt</bpmn:sourceRef>
        <bpmn:targetRef>Property_1pyo2le</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0g5sth0" name="Создание задачи в Jira" camunda:delegateExpression="${createJiraIssueDelegate}">
      <bpmn:incoming>Flow_1umzobz</bpmn:incoming>
      <bpmn:outgoing>Flow_1rucptq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_JiraCreated" name="Jira-задача создана?" default="Flow_Jira_No">
      <bpmn:incoming>Flow_1rucptq</bpmn:incoming>
      <bpmn:outgoing>Flow_Jira_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Jira_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_033lim0" name="Изменение статуса заявки на WAITING_EMPLOYEE" camunda:delegateExpression="${markApplicationWaitingEmployeeDelegate}">
      <bpmn:incoming>Flow_Jira_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_0ep786n</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_14ee1o6">
        <bpmn:targetRef>DataStoreReference_1tmkhml</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_EndJiraSuccess" name="Заявка передана модератору">
      <bpmn:incoming>Flow_0ep786n</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_0zhy1qt" name="Applications" />
    <bpmn:dataStoreReference id="DataStoreReference_1tmkhml" name="Applications" />
    <bpmn:dataStoreReference id="DataStoreReference_0wm1fpe" name="Applications" />
    <bpmn:serviceTask id="Activity_0jelz9d" name="Изменение статуса заявки на FAILED" camunda:delegateExpression="${markApplicationFailedDelegate}">
      <bpmn:incoming>Flow_Jira_No</bpmn:incoming>
      <bpmn:outgoing>Flow_12ey65h</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1fur1nd">
        <bpmn:targetRef>DataStoreReference_0wm1fpe</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_EndJiraFailed" name="Выгрузка в Jira не удалась">
      <bpmn:incoming>Flow_12ey65h</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1v13nej" sourceRef="Event_StartJiraExport" targetRef="Activity_1er5nd7" />
    <bpmn:sequenceFlow id="Flow_1umzobz" sourceRef="Activity_1er5nd7" targetRef="Activity_0g5sth0" />
    <bpmn:sequenceFlow id="Flow_1rucptq" sourceRef="Activity_0g5sth0" targetRef="Gateway_JiraCreated" />
    <bpmn:sequenceFlow id="Flow_Jira_Yes" name="Да" sourceRef="Gateway_JiraCreated" targetRef="Activity_033lim0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${jiraTaskCreated}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Jira_No" name="Нет" sourceRef="Gateway_JiraCreated" targetRef="Activity_0jelz9d" />
    <bpmn:sequenceFlow id="Flow_0ep786n" sourceRef="Activity_033lim0" targetRef="Event_EndJiraSuccess" />
    <bpmn:sequenceFlow id="Flow_12ey65h" sourceRef="Activity_0jelz9d" targetRef="Event_EndJiraFailed" />
  </bpmn:process>
